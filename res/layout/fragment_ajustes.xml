<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes y Personalización"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- J Logo Personalización -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J LOGO PERSONALIZACIÓN"
            android:textColor="@color/neon_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_logo_estilo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_neon"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/img_preview_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_logo_j" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Estilo de Logo J"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/text_gray"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Tema de Color -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tema de Color"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/color_cyan"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_glow" />

            <View
                android:id="@+id/color_purple"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_neon" />

            <View
                android:id="@+id/color_pink"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_glow" />

            <View
                android:id="@+id/color_blue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_neon" />
        </LinearLayout>

        <!-- Sliders -->
        <TextView
            android:id="@+id/tv_tamano_boton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tamaño del Botón Flotante 56px"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seekbar_tamano_boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="68"
            android:progress="24"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_opacidad_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opacidad del Panel Transparente 72%"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seekbar_opacidad_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="72"
            android:layout_marginBottom="16dp" />

        <!-- Apariencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APARIENCIA"
            android:textColor="@color/neon_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            background="@drawable/bg_card_neon"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Modo Oscuro • Tema neon futurista activado"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switch_modo_oscuro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reducir Movimiento"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switch_reducir_movimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Permisos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERMISOS"
            android:textColor="@color/neon_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_neon"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acceso a Almacenamiento"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switch_permiso_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mostrar sobre otras apps"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switch_permiso_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Acerca de -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acerca de"
            android:textColor="@color/neon_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Versión 3.2.1"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="J Tools • 2024 • Política de privacidad • Términos"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
